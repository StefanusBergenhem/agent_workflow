# .workflow/config.yaml — Project workflow configuration
# Copy this file to .workflow/config.yaml and fill in your project details.
# Template variables ({{VAR}}) must be replaced with actual values.

version: 2

project:
  name: "{{PROJECT_NAME}}"
  language: "{{LANGUAGE}}"

paths:
  roadmap: "roadmap.yaml"
  target_architecture: "TARGET_ARCHITECTURE.md"
  sprint: "sprint.yaml"
  state: "docs/STATE.md"
  memory: "docs/MEMORY.yaml"
  architecture_docs:             # Globs — all matching files are read by SA
    - "docs/adrs/*.md"
  conventions: "docs/CONVENTIONS.md"
  components: "COMPONENTS.yaml"
  master_backlog: "master_backlog.yaml"
  design_issues: "design_issues.yaml"

commands:
  test_unit: "{{TEST_UNIT_CMD}}"
  test_integration: "{{TEST_INTEGRATION_CMD}}"
  test_e2e: "{{TEST_E2E_CMD}}"
  lint: "{{LINT_CMD}}"
  type_check: "{{TYPE_CHECK_CMD}}"
  preflight: "{{PREFLIGHT_CMD}}"
  coverage: "{{COVERAGE_CMD}}"            # e.g., "npx jest --coverage", "go test -coverprofile=coverage.out ./...", "pytest --cov"
  db_validate: "{{DB_VALIDATE_CMD}}"      # e.g., "npx prisma migrate status", "alembic check"

coverage:
  threshold: 90                            # Minimum line coverage % for new/modified files
  enforce_on_new_files: true               # Require coverage check on files created by the task
  enforce_on_modified_files: true           # Require coverage check on files modified by the task
  integration_test_ratio: "per_external_dep"  # At least one integration test per external dependency interaction

review:
  max_attempts: 3
  escalation: halt

parallel:
  enabled: true
  worktree_base: ".claude/worktrees"
  max_concurrent_tasks: 4

models:
  build: "sonnet"            # Model for build sub-agents (task contracts are tight, Sonnet suffices)
  review: "sonnet"           # Model for review sub-agents (checklist-driven validation)
  retrospective: "sonnet"    # Model for retrospective sub-agents

task_sizing:
  max_files_to_touch: 3
  max_context_files: 5
  max_estimated_lines: 150

learning:
  enabled: true                            # Set false to skip lesson extraction and archival
  max_memory_entries: 30                   # Max lessons in the memory file
  archive_retrospectives: true             # Move retrospective .md to retrospective/archive/
  archive_metrics: true                    # Move sprint metrics to .workflow/archive/metrics/
  cleanup_design_issues: true              # Remove resolved design issues after extraction

observability:
  enabled: true                          # Set false to skip metrics collection
  metrics_dir: ".workflow/metrics"       # Where metrics files are written
  cost_estimation:
    enabled: true
    token_ratio: 4                       # Bytes per token (rough estimate for trending)
  trends:
    enabled: true                        # Track cross-sprint trends
    max_sprints: 20                      # Keep last N sprints in trends.yaml

external_skills:
  # External skills provide domain-specific guidance to build and review agents.
  # Skills are merged (defaults + matching domain), never overridden.
  #
  # Resolution: for each slot, collect defaults + all matching domain skills.
  # Example: a Go backend task gets implementation: ["tdd", "golang-patterns"]

  defaults:
    # Applied to ALL tasks regardless of domain.
    implementation: []    # e.g., ["tdd"]
    testing: []           # e.g., ["golang-testing"]
    review: []            # e.g., ["requesting-code-review"]

  domains:
    # Each domain has glob patterns matched against files_to_touch.
    # When a task's files match, domain skills are appended to defaults.
    # Domain commands override top-level commands for matched tasks.
    # If files span multiple domains, all matching domain skills are loaded;
    # commands use the domain with the most file matches (ties: first alphabetically).
    #
    # backend:
    #   match: ["backend/**", "**/*.go", "cmd/**", "internal/**"]
    #   skills:
    #     implementation: ["golang-patterns"]
    #     testing: ["golang-testing"]
    #   commands:                          # Optional: override top-level commands
    #     test_unit: "go test ./..."
    #     test_integration: "go test -tags=integration ./..."
    #     lint: "golangci-lint run"
    # frontend:
    #   match: ["frontend/**", "**/*.tsx", "**/*.ts", "src/components/**"]
    #   skills:
    #     implementation: ["frontend-patterns"]
    #     testing: ["vitest"]
    #   commands:
    #     test_unit: "npx vitest run"
    #     lint: "npx eslint ."
