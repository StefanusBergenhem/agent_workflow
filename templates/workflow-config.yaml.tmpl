# .workflow/config.yaml — Project workflow configuration
# Copy this file to .workflow/config.yaml and fill in your project details.
# Template variables ({{VAR}}) must be replaced with actual values.

version: 2

project:
  name: "{{PROJECT_NAME}}"
  language: "{{LANGUAGE}}"

paths:
  roadmap: "roadmap.yaml"
  sprint: "sprint.yaml"
  state: "docs/STATE.md"
  memory: "docs/MEMORY.md"
  architecture_docs:             # Globs — all matching files are read by SA
    - "**/ARCHITECTURE.md"
    - "docs/adrs/*.md"
  conventions: "docs/CONVENTIONS.md"
  components: "COMPONENTS.yaml"
  master_backlog: "master_backlog.yaml"
  design_issues: "design_issues.yaml"

commands:
  test_unit: "{{TEST_UNIT_CMD}}"
  test_integration: "{{TEST_INTEGRATION_CMD}}"
  test_e2e: "{{TEST_E2E_CMD}}"
  lint: "{{LINT_CMD}}"
  type_check: "{{TYPE_CHECK_CMD}}"
  compile_check: "{{COMPILE_CHECK_CMD}}"
  preflight: "{{PREFLIGHT_CMD}}"
  context_map: "{{CONTEXT_MAP_CMD}}"

review:
  max_attempts: 3
  escalation: halt

parallel:
  enabled: true
  worktree_base: ".claude/worktrees"
  merge_strategy: "branch-push"    # or "direct-merge"
  max_concurrent_tasks: 4

task_sizing:
  max_files_to_touch: 3
  max_context_files: 5
  max_estimated_lines: 150
