# Task Contract — .workflow/current_task.yaml
# This file is the single source of truth for the current task.
# Generated by the plan phase. Consumed by the build phase.
# Do NOT edit manually during build — request scope changes through the workflow.

# ---- Task Identity ----
# Unique identifier for this task (e.g., "PROJ-42" or "add-user-auth").
task_id: ""

# Human-readable title describing what this task accomplishes.
title: ""

# Which sprint/milestone this task belongs to.
sprint: ""

# ---- Scope Definition ----
# The precise objective. One sentence. If you cannot say it in one sentence,
# the task is too large — split it.
objective: ""

# Acceptance criteria — testable conditions that define "done".
# Each criterion should be independently verifiable.
acceptance_criteria:
  - ""

# ---- File Boundaries (Enforced by scope-guard) ----
# Files the agent is authorized to CREATE or MODIFY.
# Any file not listed here is off-limits. No exceptions without approval.
files_to_touch:
  - ""

# Files the agent may READ for understanding. These are READ-ONLY.
# Modifying a context file is a scope violation.
context_to_load:
  - ""

# ---- Dependencies ----
# Other tasks that must be completed/merged before this one can start.
depends_on: []

# ---- Testing Mandate ----
# Specifies exactly what tests must be written and what they must cover.
testing_mandate:
  # Unit tests — no external dependencies (DB, network, filesystem).
  unit_tests:
    - description: ""
      covers: ""  # Which acceptance criterion this test validates.

  # Integration tests — real dependencies, tagged appropriately.
  integration_tests:
    - description: ""
      covers: ""

  # End-to-end tests — full system tests (optional, only when needed).
  e2e_tests: []

# ---- Documentation Updates ----
# Files that must be updated as part of this task.
doc_updates_required:
  - ""

# ---- Sizing Estimates ----
# Used by the workflow to detect scope creep. If actuals exceed estimates
# by >50%, the build phase will pause for re-evaluation.
estimates:
  files_to_touch_count: 0
  lines_of_code: 0
  complexity: "low"  # low | medium | high

# ---- Plan Metadata ----
# Populated by the plan phase. Do not edit.
planned_by: ""
planned_at: ""
approved_by: ""
approved_at: ""
